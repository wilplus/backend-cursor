// SEED dataset (engineering, 2026-08-15) — the ACCENT TARGET.
// Founder: "try not to style the whole paragraphs or chunks but key few
// words or a sentence". These cases pin the two ways that goes wrong: an
// invented phrase, and a pick so wide it accents everything. Format:
// docs/prompt_evals.md
{"id": "EP-SEED-01", "surface": "emphasis_phrase", "description": "picks a narrow verbatim phrase out of a three-sentence moment", "input": {"transcript": "So we started with two people and a shared laptop. Eighteen months later we were running the whole checkout for the region. Nobody outside the team ever noticed the migration."}, "rubric": {"substring_of_input": [{"path": "quote", "input": "transcript"}], "max_chars": 180, "must_not_substring": ["So we started with two people and a shared laptop."], "semantic_intent": "A few words that carry the moment — the result or the turn, not the run-up, and never the whole passage."}}
{"id": "EP-SEED-02", "surface": "emphasis_phrase", "description": "verbatim in the SPEAKER's language — never translated to English", "input": {"transcript": "Zaczynaliśmy we dwoje przy jednym laptopie. Po półtora roku obsługiwaliśmy cały region. Nikt z zewnątrz niczego nie zauważył."}, "rubric": {"substring_of_input": [{"path": "quote", "input": "transcript"}], "max_chars": 180, "must_contain_polish_diacritic": true, "semantic_intent": "The accent target is copied from the Polish passage, character-for-character."}}
{"id": "EP-SEED-03", "surface": "emphasis_phrase", "description": "a flat, even passage: returning nothing is a correct answer", "input": {"transcript": "So then I opened the file. Then I changed the setting. Then I saved it and closed the window again."}, "rubric": {"substring_of_input": [{"path": "quote", "input": "transcript"}], "max_chars": 120, "allow_none_output": true, "semantic_intent": "Either an empty pick (nothing stands out above the rest) or a short verbatim phrase — never a widened one to seem helpful."}}
