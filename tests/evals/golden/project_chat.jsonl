// Post-Take review examples. Every recording and published note is synthetic.
{"id": "PC-AUDIENCE-PL", "surface": "project_chat", "description": "The team is the main audience even though the board approves", "input": {"language": "pl", "transcript": "Rada ma to zatwierdzić, ale mówię to głównie do zespołu.", "question": "Co byś zmienił w tym fragmencie?"}, "rubric": {"must_contain_polish_diacritic": true, "must_mention_any": ["zespoł", "zespół", "zespole"], "must_not_mention_substrings": ["?"], "expect": {"moment": null, "destination": null}, "semantic_intent": "A direct, concise Polish suggestion to focus on the team and what they need from it, with the board handled separately or no longer prominent. They said which audience is primary. Do not ask them to clarify it, swap the board and team, or invent the team's desired action."}}
{"id": "PC-UNCLEAR-AUDIENCE-PL", "surface": "project_chat", "description": "The question matters when nobody named the intended listener", "input": {"language": "pl", "transcript": "Rada może to zatwierdzić, a zespół ma wdrożyć pilota.", "question": "Jak dopasować ten fragment do odbiorców?"}, "rubric": {"must_contain_polish_diacritic": true, "must_mention_substrings": ["?"], "must_mention_any": ["do kogo", "kto będzie", "dla kogo", "komu chcesz", "kto ma", "kto jest", "kogo masz na myśli", "kto usłyszy"], "max_chars": 220, "expect": {"destination": null, "moment": null, "practise": false}}}
{"id": "PC-PRACTISE-PL", "surface": "project_chat", "description": "A direct request about the ending gets the published moment and applicable practice", "input": {"language": "pl", "transcript": "Chcę, żebyśmy dziś zatwierdzili pilota.", "question": "Pokaż mi jeden fragment do przećwiczenia na końcu.", "feedback": [{"snippet_id": "ending", "surfaced": true, "kind": "practice", "note": "The last part runs together. Separate the implementation plan from the date.", "transcript_corrected": "Zespół rusza w poniedziałek i wyśle plan we wtorek."}]}, "rubric": {"must_contain_polish_diacritic": true, "expect": {"moment": "ending", "practise": true}, "semantic_intent": "Answer the request directly in Polish. Point to the exact published closing passage and suggest one thing to try. Give the user room to listen and practise. Do not explain the opening again, invent another clip or promise a specific demo."}}
{"id": "PC-OUTPUT-PL", "surface": "project_chat", "description": "Helper words preserve the speaker's own delivery and lead to the saved Ideal Text", "input": {"language": "pl", "transcript": "Chcę, żebyśmy dziś zatwierdzili pilota.", "ideal_text": "Chcę, żebyśmy dziś zatwierdzili pilota.", "focus": {"step": "practise"}, "question": "Już spróbowałem. Jak zapamiętać, jak to powiedziałem, na kolejne nagranie?"}, "rubric": {"must_contain_polish_diacritic": true, "expect": {"destination": "ideal"}, "semantic_intent": "In Polish, offer the Take's existing Ideal Text and explain that the helper words cue both the request and how it felt or sounded when spoken in practice. Keep it brief. Do not invent saved helper words or another exercise. An invitation to open Ideal Text is sufficient to offer the document. The phrase o co prosisz means the request and jak zabrzmiała ta prośba w ćwiczeniu means how that request sounded in practice. Naming the category słowa pomocnicze does not invent any specific saved helper words."}}
{"id": "PC-ONE-STRENGTH-PL", "surface": "project_chat", "description": "One approved strength is all the recording can support", "input": {"language": "pl", "transcript": "Chcę, żebyśmy dziś zatwierdzili pilota.", "vocal_cues": ["the word dziś is emphasized", "a pause follows dziś"], "question": "Jest jeszcze jakiś dobry moment?", "feedback": [{"snippet_id": "opening", "surfaced": true, "kind": "praise", "note": "The request for a commitment today was clear.", "transcript_corrected": "Chcę, żebyśmy dziś zatwierdzili pilota."}]}, "rubric": {"must_contain_polish_diacritic": true, "expect": {"moment": "opening", "practise": false, "destination": null}, "semantic_intent": "In natural Polish say that you would need to hear more before pointing out another strong moment. Stay on the same clip and explain one precise supported detail, such as what the emphasis on today makes clear about the request. Do not claim there is a second good moment or switch to critique or an exercise."}}
{"id": "PC-SAY-IT-PL", "surface": "project_chat", "description": "Give the team one sentence they can actually say", "input": {"language": "pl", "transcript": "Mówię do zespołu. Chcę, żeby ktoś poprowadził pilotaż, jeśli dostaniemy zgodę.", "question": "Jak mogę poprosić zespół o to w jednym zdaniu?", "include_wording": true}, "rubric": {"must_contain_polish_diacritic": true, "expect": {"wording.arc_id": "eval-project", "wording.take_session_id": "eval-take"}, "expect_contains": {"wording.words": "pilotaż"}, "semantic_intent": "A short usable Polish question someone can say to the team, asking who would lead the pilot if approved. Keep it conditional. Give the actual line in wording.words. No need to ask for the known audience or their intended action again. The wording card itself must ask who is willing to lead the pilot.", "must_mention_substrings": ["?"]}}
{"id": "PC-DELIVERY-FAST-PL", "surface": "project_chat", "description": "Regular project chat grounds the same words in fast delivery", "input": {"language": "pl", "topic": "Pilotaż dla zespołu", "transcript": "Chcę, żebyście dziś zatwierdzili ten pilotaż.", "question": "Jak wybrzmiała moja prośba w tym nagraniu?", "focus": null, "metrics": {"wpm": 190, "pause_ratio": 0.04}}, "rubric": {"must_contain_polish_diacritic": true, "no_digits": true, "expect": {"moment": "opening", "destination": null}, "semantic_intent": "Reply in natural Polish about the pilot request and its hurried, passage-wide delivery or small space between words. A proposed pause for the NEXT attempt at any named word, including after dziś, is explicitly allowed. A phrase such as Spróbuj dodać pauzę proposes a change; it does not claim that the original contained that pause. Only fail the cue grounding if the answer claims the ORIGINAL recording had emphasis or a pause on a particular word. Keep the impression about this passage and its effect on the listener."}}
{"id": "PC-DELIVERY-PAUSED-PL", "surface": "project_chat", "description": "Regular project chat grounds the same words in paused delivery", "input": {"language": "pl", "topic": "Pilotaż dla zespołu", "transcript": "Chcę, żebyście dziś zatwierdzili ten pilotaż.", "question": "Jak wybrzmiała moja prośba w tym nagraniu?", "focus": null, "metrics": {"wpm": 125, "pause_ratio": 0.27}}, "rubric": {"must_contain_polish_diacritic": true, "no_digits": true, "expect": {"moment": "opening", "destination": null}, "semantic_intent": "Reply in natural Polish. Describe the exact pilot request and how the measured delivery with ample pauses makes it easier to hear or gives the request room. Do not call it hurried or invent emphasis or a pause on a specific word. Keep the read about this passage and its effect on a listener. A clearly suggested pause for a future try is allowed. The restriction applies to claims about the original recording."}}
{"id": "PC-IDEAL-DIRECT-EN", "surface": "project_chat", "description": "An ordinary project question opens its saved Ideal Text", "input": {"language": "en", "focus": null, "transcript": "I need approval for the pilot today.", "ideal_text": "I need approval for the pilot today.", "question": "Can you show me the Ideal Text for this recording?"}, "rubric": {"expect": {"destination": "ideal", "moment": null}, "semantic_intent": "The structural destination assertion verifies that the existing Ideal Text is offered in the app. Judge the prose: a direct, brief answer about this project and recording. One short supported explanation of how the document can help is allowed. Do not invent a new draft or ask the speaker to select a project."}}
{"id":"PC-LIVE-IMPROVE-EN","surface":"project_chat","description":"A weaker moment in the live conversation comes with something to try","input":{"language":"en","live_take_feedback":true,"transcript":"I need approval for the pilot today.","question":"What should I work on in my closing?","feedback":[{"snippet_id":"ending","surfaced":true,"kind":"practice","note":"The launch date and the decision arrive in one breath. Leave a pause before the date.","transcript_corrected":"Please approve the pilot and we'll start Monday."}]},"rubric":{"expect":{"moment":"ending","practise":true,"destination":null},"semantic_intent":"Answer the question about the closing with the exact published moment. The intervention gives one concrete thing the speaker can say or record here, such as pausing before Monday. Keep the conversation at this moment."}}
{"id":"PC-LIVE-FINISH-PL","surface":"project_chat","description":"Finishing the rehearsal opens the Ideal Text and offers the next Take","input":{"language":"pl","live_take_feedback":true,"transcript":"Chcę, żebyśmy dziś zatwierdzili pilota. Zespół może zacząć w poniedziałek.","ideal_text":"Chcę, żebyśmy dziś zatwierdzili pilota. Zespół może zacząć w poniedziałek.","focus":{"step":"practise","snippet_id":"opening"},"question":"Tyle na razie. Pokaż mi Ideal Text i zaproponuj, co przećwiczyć w kolejnym nagraniu."},"rubric":{"must_contain_polish_diacritic":true,"no_digits":true,"expect":{"destination":"ideal","moment":null,"record_next":true},"expect_contains":{"readiness":"?"},"semantic_intent":"Offer the existing Ideal Text and briefly connect its helper words to the speaker's own decision request. In the readiness text, describe in words what is working or worth another rehearsal and end with one natural invitation. Avoid numeric ratings and unsupported claims about what has improved."}}
{"id":"PC-CRITIQUE-PACE-EN","surface":"project_chat","description":"Colloquial critique asks for one weak passage with practice","input":{"language":"en","focus":null,"transcript":"I think the launch could go ahead on Friday.","metrics":{"wpm":191,"pause_ratio":0.04},"history":[{"role":"user","body":"How was my pace?"},{"role":"bot","body":"The launch line came out quickly.","moment":"opening"}],"question":"and some critics?"},"rubric":{"expect":{"moment":"opening","practise":true,"destination":null},"must_not_mention_substrings":["?"],"semantic_intent":"Answer with one specific observation about the rushed launch line and tell the speaker where to pause or give a phrase more room in their next try. Refer to the launch wording. Do not answer with a generic question or claim that a particular tool or demo is available."}}
{"id":"PC-SNIPER-HERE-EN","surface":"project_chat","description":"A named practice follows the previously cited clip after reload","input":{"language":"en","focus":null,"transcript":"I think the launch could go ahead on Friday.","metrics":{"wpm":191,"pause_ratio":0.04},"history":[{"role":"bot","body":"Friday came and went quickly in the launch line.","moment":"opening"}],"feedback":[{"snippet_id":"ending","surfaced":true,"kind":"fix","note":"The request for a decision was vague.","transcript_corrected":"Can we decide by next week?"}],"question":"actually I would like to try sniper here?"},"rubric":{"expect":{"moment":"opening","practise":true,"destination":null,"practice_tool":"sniper"},"expect_contains":{"answer":"pace"}}}
{"id":"PC-WEAKER-PACE-PL","surface":"project_chat","description":"The weakest passage gets a cue in the language of the question","input":{"language":"pl","focus":null,"transcript":"Zacznijmy od pilotażu i w piątek sprawdźmy wyniki.","metrics":{"wpm":190,"pause_ratio":0.04},"question":"Pokaż mi najsłabszy fragment."},"rubric":{"must_contain_polish_diacritic":true,"expect":{"moment":"opening","practise":true,"destination":null},"semantic_intent":"Use natural Polish. Point to the exact recorded line about the pilot and checking results. A concrete place to slow down or leave space, such as before or after the word pilotażu, is enough to identify the passage. Give one useful thing to try. Do not claim a tool is available."}}
{"id":"PC-TOPIC-CARS-EN","surface":"project_chat","description":"The speaker can analyse and practise a described words-only fragment after Ideal Text","input":{"language":"en","focus":{"step":"ideal"},"live_take_feedback":true,"transcript":"Today I am reviewing the pilot's schedule.","ideal_text":"Today I am reviewing the pilot's schedule. We switched cars right before the brake test.","metrics":{"wpm":190},"snippets":[{"id":"cars","transcript":"We switched cars right before the brake test. We kept the route the same."}],"question":"The part when I was talking about the cars, I felt insecure there. Could you analyse that? Can we practice it?"},"rubric":{"expect":{"moment":"cars","practise":true,"destination":null},"expect_contains":{"answer":"?"},"semantic_intent":"Identify the actual cars fragment and use a short quotation or its precise detail about changing cars before the brake test or keeping the route. Reflect that the speaker reported feeling insecure and ask one focused question about what made that passage feel difficult. Offer one concrete next try in the answer or intervention, such as leading with the unchanged route or the reason for switching cars. Do not infer rushed delivery from the unrelated opening. Do not assert a threat state or lack of competence."}}
{"id":"PC-TOPIC-POLISH-PL","surface":"project_chat","description":"An analysis request recalls the exact Polish fragment and reflects uncertainty","input":{"language":"pl","focus":null,"transcript":"Najpierw powiem o harmonogramie.","snippets":[{"id":"cars","transcript":"Zmieniliśmy samochód tuż przed próbą hamowania.","metrics":{"wpm":180,"pause_ratio":0.05}}],"question":"Fragment, w którym mówiłem o samochodach, wydawał mi się niepewny. Co słyszysz?"},"rubric":{"must_contain_polish_diacritic":true,"expect":{"moment":"cars"},"semantic_intent":"Answer in Polish about the exact Polish line on switching cars before the brake test. Pair the words with their quick delivery if useful and reflect that it felt uncertain to the speaker. Explore what made it feel difficult as a possibility or one short question. Do not say they lacked competence or diagnose anxiety or threat."}}
{"id":"PC-UNKNOWN-FRAGMENT-EN","surface":"project_chat","description":"An unidentifiable topic gets a question instead of a different clip","input":{"language":"en","focus":null,"transcript":"Today I am reviewing the pilot's schedule.","snippets":[{"id":"cars","transcript":"We switched cars before the brake test."}],"question":"The part where I explained the boat engine, can we practice it?"},"rubric":{"expect":{"moment":null,"practise":false,"destination":null},"expect_contains":{"answer":"?"},"semantic_intent":"Ask one brief question that can identify the missing boat-engine passage or its recording. Keep the boat topic clear. Acknowledge the gap and leave the exercise for the right clip. Do not offer the car recording or imply that you found the boat recording."}}
{"id":"PC-RECORD-AFTER-IDEAL-EN","surface":"project_chat","description":"A direct follow-up after Ideal Text offers the existing recording action","input":{"language":"en","focus":{"step":"ideal"},"live_take_feedback":true,"transcript":"Please approve the pilot today.","ideal_text":"Please approve the pilot today.","question":"Can I record again?"},"rubric":{"expect":{"destination":null,"moment":null,"record_next":true},"semantic_intent":"Answer yes or invite another recording directly and briefly. A practical cue for that recording is fine. Do not repeat the Ideal Text, ask setup questions, or claim to have started recording."}}
{"id":"PC-LATER-SLIDES-PL","surface":"project_chat","description":"A follow-up about the rest of a Take moves beyond an already cited opening","input":{"language":"pl","topic":"Pilotaż dla zarządu","transcript":"Dziś proszę zarząd o zatwierdzenie pilotażu.","metrics":{"wpm":145,"piece":{"slide_index":0}},"snippets":[{"id":"pilot-details","transcript":"Pilotaż obejmie dwa zespoły. Wyniki pokażemy w grudniu.","start_offset_ms":8000,"metrics":{"piece":{"slide_index":1}}},{"id":"website","transcript":"Na koniec opowiem o naszej nowej stronie internetowej.","start_offset_ms":18000,"metrics":{"piece":{"slide_index":2}}}],"feedback":[{"snippet_id":"opening","surfaced":true,"kind":"praise","note":"Jasno prosisz o decyzję.","transcript_corrected":"Dziś proszę zarząd o zatwierdzenie pilotażu."}],"history":[{"role":"user","body":"Moim celem było dostać od zarządu zgodę na pilotaż."},{"role":"bot","body":"W otwarciu jasno prosisz o zatwierdzenie pilotażu.","moment":"opening"}],"question":"Czy na kolejnych slajdach trzymałem się celu, czy mówiłem o czymś innym?","live_take_feedback":true},"rubric":{"must_contain_polish_diacritic":true,"expect":{"moment":"website","destination":null},"semantic_intent":"Answer in Polish. Say that the two teams or reporting results on the second slide supports the requested pilot, and that the new website at the end strays from it. Offer one usable edit or concrete final line about the decision. Cite the later clip and do not replay or re-praise the opening."}}
{"id":"PC-AI-AUDIO-TEGO-PL","surface":"project_chat","description":"An explicit Polish AI audio follow-up keeps the exact cited fragment and tool in the project","input":{"language":"pl","focus":{"step":"feedback","snippet_id":"slide-two"},"live_take_feedback":true,"transcript":"Na początek wyjaśnię cel spotkania.","snippets":[{"id":"slide-two","transcript":"Omówię zakres pilotażu i od razu przejdę do wyników.","start_offset_ms":10000,"metrics":{"wpm":190,"pause_ratio":0.04}}],"history":[{"role":"bot","body":"Na drugim slajdzie przyda się chwila oddechu.","moment":"slide-two"}],"question":"pokażesz mi AI audio tego?"},"rubric":{"must_contain_polish_diacritic":true,"expect":{"moment":"slide-two","practise":true,"practice_tool":"ai_audio","destination":null},"expect_contains":{"answer":"dla tego fragmentu"}}}
{"id":"PC-NEW-RECORDED-ENDING-PL","surface":"project_chat","description":"An unprompted second recorded ending uses its own words and comfortable delivery","input":{"language":"pl","topic":"Decyzja o pilotażu","audience":"zespół","goal":"wybrać osobę do poprowadzenia pilotażu","focus":null,"transcript":"Te narzędzia otwierają nam wiele różnych dróg.","metrics":{"wpm":192,"pause_ratio":0.03},"history":[{"role":"user","body":"No i to wszystkie narzędzia, które mamy. Tyle ode mnie.","recording":{"transcript":"No i to wszystkie narzędzia, które mamy. Tyle ode mnie.","delivery":"Delivery across the whole passage: quick pace, little space between phrases"}},{"role":"bot","body":"Zakończ prośbą, która pokaże zespołowi, co ma zrobić. Nagraj nową końcówkę.","voice_focus":0}],"question":"Także to wszystko, resztę znajdziecie w pliku.","recording":{"transcript":"Także to wszystko, resztę znajdziecie w pliku.","delivery":"Delivery across the whole passage: comfortable pace, space between phrases"},"include_wording":true},"rubric":{"must_contain_polish_diacritic":true,"expect":{"moment":null,"destination":null,"voice_source":"clip","voice_is_current":true,"playback":false},"semantic_intent":"Respond to the newly recorded ending about finding the rest in the file. Help it serve the actual goal of asking who can lead the pilot by giving a short sayable question in wording.words. If commenting on this attempt's sound, respect its comfortable pace. Do not repeat the original tools passage, prescribe slowing this version based on older cues, or ask a generic question about techniques. Acknowledge context and make the next try easy."}}
{"id":"PC-NEW-RECORDING-WORDS-ONLY-PL","surface":"project_chat","description":"A new recording without usable vocal analysis still gets useful wording coaching","input":{"language":"pl","topic":"Spotkanie zespołu","audience":"zespół","goal":"poprosić o uwagi do planu","focus":null,"transcript":"To są różne drogi prowadzące do celu.","metrics":{"wpm":190,"pause_ratio":0.04},"history":[{"role":"bot","body":"Spróbuj teraz zakończyć konkretną prośbą do zespołu.","moment":"opening"}],"question":"No i jeśli macie jakieś pytania albo coś, to piszcie, chyba tyle.","recording":{"transcript":"No i jeśli macie jakieś pytania albo coś, to piszcie, chyba tyle.","delivery":null},"include_wording":true},"rubric":{"must_contain_polish_diacritic":true,"expect":{"moment":null,"voice_source":"clip","voice_is_current":true,"playback":false},"semantic_intent":"Help with the latest closing request about questions or writing back. Give a clear sayable request for feedback on the plan in wording.words, preserving that the audience is the team. Do not claim to hear rushing, confidence, emphasis, or other delivery without observations. Do not refuse all coaching merely because the vocal analysis is unavailable, and do not return to the unrelated original Take."}}
{"id": "PC-TYPED-REVISION-AFTER-MIC-EN", "surface": "project_chat", "description": "A typed third version has new words and no newly heard delivery", "input": {"language": "en", "topic": "Pilot review", "audience": "the team", "goal": "get someone to lead the pilot if approved", "focus": null, "transcript": "Our tools could take us in many directions.", "history": [{"role": "user", "body": "So I think someone could maybe look at the pilot.", "recording": {"transcript": "So I think someone could maybe look at the pilot.", "delivery": "Delivery across the whole passage: quick pace, little space between phrases"}}, {"role": "bot", "body": "Try asking the team directly who could lead it.", "voice_focus": 0}], "question": "My new ending is: Who could lead the pilot? Please include that it depends on approval and give me the exact words I can say.", "include_wording": true}, "rubric": {"expect": {"moment": null, "voice_source": "clip", "voice_is_current": false, "playback": false}, "semantic_intent": "Answer the current typed draft about who could lead the pilot and preserve the pending approval by offering a concise conditional question in wording.words. Treat this as wording, not a newly heard performance. Do not claim its pace improved or transfer the earlier recording's fast pace to it. Do not return the original Take or a generic techniques question."}}
{"id":"PC-MIC-OWN-VOCAL-PL","surface":"project_chat","description":"A vocal explanation can replay the exact chat recording rather than the old Take","input":{"language":"pl","topic":"Pilotaż","audience":"zespół","goal":"zgoda na pilotaż","focus":null,"transcript":"Najpierw opowiem o narzędziach.","metrics":{"wpm":190,"pause_ratio":0.04},"question":"Jak brzmi to, co właśnie nagrałem?","recording":{"transcript":"Proszę was o zgodę na pilotaż.","delivery":"Delivery across the whole passage: comfortable pace, space between phrases"},"include_wording":true},"rubric":{"must_contain_polish_diacritic":true,"expect":{"moment":null,"voice_source":"clip","voice_is_current":true,"playback":true},"semantic_intent":"Reflect the new chat recording's clear request for approval and its comfortable pacing or space between phrases. Replay that saved mic recording when explaining this audible impression. Do not repeat the tools opening or describe the new version as rushed because the old Take was quick. Do not invent emphasis on a particular word or a measured improvement between versions."}}
