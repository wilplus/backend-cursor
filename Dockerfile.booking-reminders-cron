# Minimal image for the Railway *cron-only* booking-reminders service (not the
# web app). Cloned from Dockerfile.life-reminders-cron: a curl one-shot that
# pokes the Flask route and exits.
#
# Railway: New service → connect repo → Settings:
#   Builder: Dockerfile
#   Dockerfile path: Dockerfile.booking-reminders-cron
#   Cron Schedule: */5 * * * *   (every 5 minutes)
#   Variables: BOOKING_BACKEND_URL, BOOKING_REMINDER_SECRET (the same secret
#   as on the web service)
#
# Founder 2026-10-25 (N144): the WhatsApp reminder 1 hour before a booking.
# The backend claims each booking before sending, so a double-fired schedule
# sends nothing twice.
FROM curlimages/curl:8.20.0
WORKDIR /app
COPY bin/railway-booking-reminders-cron.sh /app/run.sh
ENTRYPOINT ["/bin/sh", "/app/run.sh"]
