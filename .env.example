# Copy to .env and fill values. See docs/REFERENCE-VIDEO-UPLOAD-LIMITS.md for large uploads.

# --- Reference video upload (Training Studio) ---
# App-side max body for multipart field `video_file` on POST /v2/admin/copilot/reference-videos/upload
MAX_REFERENCE_VIDEO_SIZE_MB=500

# Gunicorn worker timeout (seconds); large/slow uploads need 15–30+ minutes on slow links
GUNICORN_TIMEOUT=1800

# CORS: comma-separated origins allowed to call the API with Bearer + multipart (include production admin URL)
# Example: CORS_ORIGINS=https://app.willonski.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
