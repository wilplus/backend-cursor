# Copy to .env and fill values. See docs/REFERENCE-VIDEO-UPLOAD-LIMITS.md for large uploads.

# --- Reference video upload (Training Studio) ---
# App-side max body for multipart field `video_file` on POST /v2/admin/copilot/reference-videos/upload
MAX_REFERENCE_VIDEO_SIZE_MB=500

# Gunicorn worker timeout (seconds); large/slow uploads need 15–30+ minutes on slow links
GUNICORN_TIMEOUT=1800

# Reference videos/audio: extract compact mono MP3 via ffmpeg before Whisper (install ffmpeg; Railway: apt.txt)
# FFMPEG_PATH=ffmpeg
# REFERENCE_VIDEO_FFMPEG_EXTRACT=true
# Max seconds of audio sent to Whisper after extract (keeps file under API limits on long videos)
# REFERENCE_VIDEO_WHISPER_MAX_AUDIO_SECONDS=3600

# CORS: comma-separated origins for browser → API (admin polling, uploads). FRONTEND_URL origin is added automatically.
# If admin runs on another host, list it: CORS_ORIGINS=https://app.example.com,https://studio.example.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Migrations (scripts/migrate.py — see docs/MIGRATIONS.md) ---
# Direct Postgres connection string, used ONLY by the migration runner. The
# Flask app talks to Supabase over PostgREST and never reads this.
# Supabase: Dashboard → Project Settings → Database → Connection string.
# Use the SESSION pooler (port 5432), NOT the transaction pooler (6543): the
# runner's concurrency guard is a session-scoped pg_advisory_lock, and a
# transaction pooler multiplexes per transaction so the lock silently stops
# working. The runner warns if it sees :6543. The direct connection
# (db.<ref>.supabase.co) also works but is IPv6-only on newer projects, which
# Railway can't reach. Without this var the runner exits 2 ("cannot run") and
# deploys still succeed — you then apply migrations by hand in the SQL Editor.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#
# Recorded in schema_migrations.applied_by. Defaults to $USER locally,
# 'railway-deploy' from bin/railway-migrate.sh.
# MIGRATION_ACTOR=
#
# Set to 1 on the ONE service that owns migrations to make a missing
# DATABASE_URL fail its deploy instead of silently skipping.
# MIGRATE_REQUIRED=0
#
# Opt-in fallback: apply migrations on web boot when a Railway pre-deploy
# command isn't available. Never fails the boot (live-loop constraint), so
# prefer bin/railway-migrate.sh as a pre-deploy command.
# MIGRATE_ON_BOOT=0

# --- Cloudflare R2 (coach / reference / feedback videos; optional — omit to keep Supabase Storage) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# COACH_FEEDBACK_VIDEO_BUCKET=coach-feedback-videos
# R2_BUCKET_NAME=coach-feedback-videos
# R2_PUBLIC_BASE_URL=https://videos.example.com

# --- Durable recording-pipeline queue (async-queue work 2026-08-03) ---
# Master switch: with PIPELINE_QUEUE_ENABLED=1 AND REDIS_URL set, the lab
# upload 202s with a job_id and the pipeline runs on the worker service
# (sh bin/railway-worker.sh); job state of record is Postgres
# (migrations/add_processing_jobs.sql). Off / broker down ⇒ falls back to
# the ASYNC_ANALYSIS_ENABLED daemon or the legacy sync path.
# PIPELINE_QUEUE_ENABLED=0
# REDIS_URL=redis://default:password@host:6379
# PIPELINE_QUEUE_NAME=pipeline
# PIPELINE_JOB_TIMEOUT_SECONDS=3600
# PIPELINE_JOB_MAX_ATTEMPTS=3
# PIPELINE_JOB_STALE_MINUTES=15
# PIPELINE_JOB_HEARTBEAT_SECONDS=60
# PIPELINE_SWEEP_INTERVAL_SECONDS=300
# Shared secret for POST /v2/internal/jobs/sweep (unset ⇒ endpoint 503s).
# PIPELINE_JOBS_SWEEP_SECRET=
# Strict OpenAI client timeouts (SDK default was 600s per hung call).
# OPENAI_TIMEOUT_SECONDS=120
# OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=600
# OPENAI_MAX_RETRIES=2

# --- Rate limiting on the paid routes (services/rate_limits.py) ---
# ON by default. Counters live in REDIS_URL above (same broker as the
# queue, namespaced by key prefix) so the cap is ONE number across all
# gunicorn workers. With no REDIS_URL it degrades to memory:// — still
# capped, but per-worker and lost on restart (a boot WARNING says so).
# Only routes that spend money on OpenAI are capped; health probes, cron
# webhooks and the FE's polling GETs are untouched.
# RATE_LIMIT_ENABLED=1
# Point the limiter at a different Redis than the queue (rarely needed).
# RATE_LIMIT_STORAGE_URI=
# moving-window (default) | fixed-window — moving-window denies the
# burst-at-the-boundary that fixed-window allows.
# RATE_LIMIT_STRATEGY=moving-window
# Per-tier caps, keyed per signed-in user (else per IP). Defaults stop a
# runaway client loop while sitting far above real human usage — raise
# HERE before touching the code.
# RATE_LIMIT_WHISPER=20 per minute;200 per hour      # audio → transcription
# RATE_LIMIT_LLM=30 per minute;400 per hour          # one chat/coaching call
# RATE_LIMIT_HEAVY=10 per minute;100 per hour        # multi-call generation
# Per-session double-click guard on the icebreaker regenerate endpoint.
# RATE_LIMIT_REGENERATE=1 per minute
# Publish X-RateLimit-* budget headers. OFF by default because flask-limiter
# also stamps Retry-After on SUCCESSFUL responses when this is on, and a FE
# that backs off on "Retry-After present?" would throttle itself on 200s.
# The 429 body/header carry retry timing either way.
# RATE_LIMIT_HEADERS=0
# The anonymous funnel's two hourly caps keep their existing vars:
# GUEST_FUNNEL_RATE_LIMIT_PER_IP_PER_HOUR / _GLOBAL_PER_HOUR (above).

# --- Recommendation engine v1 (behavioral profile diagnosis on session completion) ---
# When true, completed sessions get ai_suggested_profile + ai_suggested_task_id
# populated for the admin dashboard. Default off — enable after the dashboard UI ships.
# DIAGNOSE_SESSION_STATE_ENABLED=false

# --- dev-bugs internal collector (dev.willpowerlab.com) ---
# Founder-only bug jotter (text/voice/image) -> dev_bugs table, emailed to
# DEV_BUGS_TO every 3 days by a Railway cron. See docs/DEV-BUGS-SETUP.md.
# Long random shared secret the frontend/cron send as `x-dev-key`. Empty ->
# the /api/dev-bugs API is disabled (503). REQUIRED to switch the tool on.
DEV_BUGS_KEY=
# Digest recipient. Defaults to ADMIN_EMAIL (artur@willonski.com) if unset.
# DEV_BUGS_TO=artur@willonski.com
# Host that serves the collector page at "/". Defaults to dev.willpowerlab.com.
# DEV_BUGS_HOST=dev.willpowerlab.com
# NOTE: the digest uses the existing Resend mailer, so SEND_EMAILS=true and
# RESEND_API_KEY must be set for mail to actually go out.
# On the separate Railway cron service also set:
#   DEV_BUGS_BACKEND_URL=https://dev.willpowerlab.com   (and the same DEV_BUGS_KEY)

# --- The Life Panel (/v2/life/*, founder-directed 2026-07-26) ---
# Personal life-governance surface: principles engine, strategy documents,
# daily card, timeline. Run migrations/add_life_panel.sql first.
# Global kill switch. DEFAULT OFF — every /v2/life/* route 404s and the chat
# router hook is never reached, so chat stays byte-identical to today.
LIFE_PANEL_ENABLED=0
# Comma-separated user ids for the FOUNDER-ONLY surfaces (prayer link, and
# anything coach-only). NOT the principles engine — that ships public behind
# the consent screen (L-6). Non-allowlisted callers get 404, never 403.
# LIFE_PANEL_ALLOWLIST=
# Bump when the consent copy changes materially; users on an older version are
# re-asked before any further life row is written.
# LIFE_PANEL_CONSENT_VERSION=1.0

# --- Life Panel OPT-IN web-push reminders (founder decision 2026-07-30) ---
# Run migrations/add_life_push_reminders.sql first. Every reminder slot is OFF
# by default per user; nothing fires until a user flips a switch in the panel
# settings. Delivery lives ONLY in services/life_reminders.py.
# Generate a VAPID pair once (e.g. `npx web-push generate-vapid-keys` or
# `vapid --gen`); the public key is served to browsers, the private key signs.
# Absent keys ⇒ the FE hides the reminder section and sending is a no-op.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@willpowerlab.com
# Guards POST /v2/internal/life/reminders (the cron webhook). Unset ⇒ 503.
# # Guards POST /v2/internal/drift/run (the weekly PM-3 drift job).
# ABSENT => the route 503s and the monitor is dead by default.
DRIFT_MONITOR_SECRET=

LIFE_REMINDER_SECRET=
# Optional, for the five/ten-year checkout slots: a year on the cadence
# (e.g. 2025). Their crons fire yearly; the backend no-ops the years where
# (year - anchor) is not a whole number of periods. Unset ⇒ they fire
# whenever their cron does (the operator picks years by hand).
# LIFE_REMINDER_ANCHOR_YEAR=
# On the separate Railway cron services (one per slot) also set:
#   LIFE_BACKEND_URL=https://dev.willpowerlab.com
#   LIFE_REMINDER_SECRET=<same as above>
#   LIFE_REMINDER_SLOT=morning|evening|weekly|monthly|quarterly|yearly|fiveyear|tenyear

# ── P0/P2 ops sweep 2026-08-03 — see docs/OPS-SECRETS-AND-STAGING.md ───

# --- Error sanitization ---
# When 0 (or in production/staging), error responses carry GENERIC copy plus a
# correlation `ref`; the real exception goes to the log + Sentry under that ref.
# Defaults ON in development so a dev sees the real error without tailing logs.
# Set it to 0 in staging to rehearse the exact envelope production returns.
# EXPOSE_ERROR_DETAILS=1

# --- Sentry sampling ---
# traces_sample_rate was hardcoded 1.0 (a transaction per request, health checks
# included) which burned the quota that ERROR capture depends on. 5% in
# production, 0 elsewhere. Error capture is never sampled by these.
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_PROFILES_SAMPLE_RATE=0.0
# Release tag for Sentry; Railway injects RAILWAY_GIT_COMMIT_SHA automatically.
# RELEASE_SHA=

# --- Synchronous upload deadline ---
# Wall-clock budget (seconds) for the sync upload→analysis path, checked at
# stage boundaries. Bounds the SUM of the per-step timeouts so a slow run
# returns 504 PROCESSING_TIMEOUT instead of parking a gunicorn worker until
# --timeout 1800 reaps it. 0 disables. The FE's BFF maxDuration must exceed it.
# SYNC_UPLOAD_DEADLINE_SECONDS=600

# --- Lab audio bucket (separates the user's voice from coach media) ---
# BOTH must be set for the split to activate. Setting only the bucket would
# write to the new location while still minting URLs against the OLD public
# domain, so every new take's audio_url would 404. Reads always fall back
# across buckets, so nothing written pre-cutover becomes unreadable and
# unsetting these rolls the change back. Same R2 account/credentials as above.
# R2_LAB_AUDIO_BUCKET=willab-lab-audio
# R2_LAB_AUDIO_PUBLIC_BASE_URL=https://lab-audio.willpowerlab.com

# --- Secrets indirection ---
# Any secret below can instead be supplied as a FILE path via <NAME>_FILE —
# the idiom Docker secrets / Kubernetes projected volumes / Vault Agent / the
# AWS Secrets Manager CSI driver all speak. The file form keeps the value out
# of /proc/<pid>/environ and out of inherited subprocess environments. When
# <NAME>_FILE is set but unreadable we resolve to NOTHING rather than falling
# back to a stale env var. Applies to: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_JWT_SECRET, OPENAI_API_KEY, RESEND_API_KEY, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# --- Staging safety (ENV=staging) ---
# The boot audit (services/secrets.py) REFUSES to start staging when any of
# these is wrong: staging pointed at the production database, a live Stripe
# key, or SEND_EMAILS=true with no redirect. A staging box that boots anyway
# is more dangerous than one that doesn't, because people trust it.
# ENV=staging
# Set to the PRODUCTION Supabase URL so a mis-pasted SUPABASE_URL is caught.
# Not a credential — just a string to compare against.
# PRODUCTION_SUPABASE_URL=https://<production-project>.supabase.co
# In any non-production env, EVERY outbound email goes to this one address
# instead of the real recipient, subject-tagged with who it was for.
# EMAIL_REDIRECT_TO=qa@willpowerlab.com
