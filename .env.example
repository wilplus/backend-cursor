# Copy to .env and fill values. See docs/REFERENCE-VIDEO-UPLOAD-LIMITS.md for large uploads.

# --- Reference video upload (Training Studio) ---
# App-side max body for multipart field `video_file` on POST /v2/admin/copilot/reference-videos/upload
MAX_REFERENCE_VIDEO_SIZE_MB=500

# Gunicorn worker timeout (seconds); large/slow uploads need 15–30+ minutes on slow links
GUNICORN_TIMEOUT=1800

# Reference videos/audio: extract compact mono MP3 via ffmpeg before Whisper (install ffmpeg; Railway: apt.txt)
# FFMPEG_PATH=ffmpeg
# REFERENCE_VIDEO_FFMPEG_EXTRACT=true
# Max seconds of audio sent to Whisper after extract (keeps file under API limits on long videos)
# REFERENCE_VIDEO_WHISPER_MAX_AUDIO_SECONDS=3600

# CORS: comma-separated origins for browser → API (admin polling, uploads). FRONTEND_URL origin is added automatically.
# If admin runs on another host, list it: CORS_ORIGINS=https://app.example.com,https://studio.example.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Migrations (scripts/migrate.py — see docs/MIGRATIONS.md) ---
# Direct Postgres connection string, used ONLY by the migration runner. The
# Flask app talks to Supabase over PostgREST and never reads this.
# Supabase: Dashboard → Project Settings → Database → Connection string → URI.
# Prefer the SESSION pooler (port 5432) over the transaction pooler (6543):
# migrations are DDL in explicit transactions and the transaction pooler
# breaks them. Without this the runner exits 2 ("cannot run") and deploys
# still succeed — you then apply migrations by hand in the SQL Editor.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#
# Recorded in schema_migrations.applied_by. Defaults to $USER locally,
# 'railway-deploy' from bin/railway-migrate.sh.
# MIGRATION_ACTOR=
#
# Set to 1 on the ONE service that owns migrations to make a missing
# DATABASE_URL fail its deploy instead of silently skipping.
# MIGRATE_REQUIRED=0
#
# Opt-in fallback: apply migrations on web boot when a Railway pre-deploy
# command isn't available. Never fails the boot (live-loop constraint), so
# prefer bin/railway-migrate.sh as a pre-deploy command.
# MIGRATE_ON_BOOT=0

# --- Cloudflare R2 (coach / reference / feedback videos; optional — omit to keep Supabase Storage) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# COACH_FEEDBACK_VIDEO_BUCKET=coach-feedback-videos
# R2_BUCKET_NAME=coach-feedback-videos
# R2_PUBLIC_BASE_URL=https://videos.example.com

# --- Durable recording-pipeline queue (async-queue work 2026-08-03) ---
# Master switch: with PIPELINE_QUEUE_ENABLED=1 AND REDIS_URL set, the lab
# upload 202s with a job_id and the pipeline runs on the worker service
# (sh bin/railway-worker.sh); job state of record is Postgres
# (migrations/add_processing_jobs.sql). Off / broker down ⇒ falls back to
# the ASYNC_ANALYSIS_ENABLED daemon or the legacy sync path.
# PIPELINE_QUEUE_ENABLED=0
# REDIS_URL=redis://default:password@host:6379
# PIPELINE_QUEUE_NAME=pipeline
# PIPELINE_JOB_TIMEOUT_SECONDS=3600
# PIPELINE_JOB_MAX_ATTEMPTS=3
# PIPELINE_JOB_STALE_MINUTES=15
# PIPELINE_JOB_HEARTBEAT_SECONDS=60
# PIPELINE_SWEEP_INTERVAL_SECONDS=300
# Shared secret for POST /v2/internal/jobs/sweep (unset ⇒ endpoint 503s).
# PIPELINE_JOBS_SWEEP_SECRET=
# Strict OpenAI client timeouts (SDK default was 600s per hung call).
# OPENAI_TIMEOUT_SECONDS=120
# OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=600
# OPENAI_MAX_RETRIES=2

# --- Recommendation engine v1 (behavioral profile diagnosis on session completion) ---
# When true, completed sessions get ai_suggested_profile + ai_suggested_task_id
# populated for the admin dashboard. Default off — enable after the dashboard UI ships.
# DIAGNOSE_SESSION_STATE_ENABLED=false

# --- dev-bugs internal collector (dev.willpowerlab.com) ---
# Founder-only bug jotter (text/voice/image) -> dev_bugs table, emailed to
# DEV_BUGS_TO every 3 days by a Railway cron. See docs/DEV-BUGS-SETUP.md.
# Long random shared secret the frontend/cron send as `x-dev-key`. Empty ->
# the /api/dev-bugs API is disabled (503). REQUIRED to switch the tool on.
DEV_BUGS_KEY=
# Digest recipient. Defaults to ADMIN_EMAIL (artur@willonski.com) if unset.
# DEV_BUGS_TO=artur@willonski.com
# Host that serves the collector page at "/". Defaults to dev.willpowerlab.com.
# DEV_BUGS_HOST=dev.willpowerlab.com
# NOTE: the digest uses the existing Resend mailer, so SEND_EMAILS=true and
# RESEND_API_KEY must be set for mail to actually go out.
# On the separate Railway cron service also set:
#   DEV_BUGS_BACKEND_URL=https://dev.willpowerlab.com   (and the same DEV_BUGS_KEY)

# --- The Life Panel (/v2/life/*, founder-directed 2026-07-26) ---
# Personal life-governance surface: principles engine, strategy documents,
# daily card, timeline. Run migrations/add_life_panel.sql first.
# Global kill switch. DEFAULT OFF — every /v2/life/* route 404s and the chat
# router hook is never reached, so chat stays byte-identical to today.
LIFE_PANEL_ENABLED=0
# Comma-separated user ids for the FOUNDER-ONLY surfaces (prayer link, and
# anything coach-only). NOT the principles engine — that ships public behind
# the consent screen (L-6). Non-allowlisted callers get 404, never 403.
# LIFE_PANEL_ALLOWLIST=
# Bump when the consent copy changes materially; users on an older version are
# re-asked before any further life row is written.
# LIFE_PANEL_CONSENT_VERSION=1.0

# --- Life Panel OPT-IN web-push reminders (founder decision 2026-07-30) ---
# Run migrations/add_life_push_reminders.sql first. Every reminder slot is OFF
# by default per user; nothing fires until a user flips a switch in the panel
# settings. Delivery lives ONLY in services/life_reminders.py.
# Generate a VAPID pair once (e.g. `npx web-push generate-vapid-keys` or
# `vapid --gen`); the public key is served to browsers, the private key signs.
# Absent keys ⇒ the FE hides the reminder section and sending is a no-op.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@willpowerlab.com
# Guards POST /v2/internal/life/reminders (the cron webhook). Unset ⇒ 503.
# LIFE_REMINDER_SECRET=
# Optional, for the five/ten-year checkout slots: a year on the cadence
# (e.g. 2025). Their crons fire yearly; the backend no-ops the years where
# (year - anchor) is not a whole number of periods. Unset ⇒ they fire
# whenever their cron does (the operator picks years by hand).
# LIFE_REMINDER_ANCHOR_YEAR=
# On the separate Railway cron services (one per slot) also set:
#   LIFE_BACKEND_URL=https://dev.willpowerlab.com
#   LIFE_REMINDER_SECRET=<same as above>
#   LIFE_REMINDER_SLOT=morning|evening|weekly|monthly|quarterly|yearly|fiveyear|tenyear
